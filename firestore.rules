rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== 헬퍼 함수 ==========
    
    // 사용자가 인증되었는지 확인
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // 학생: 익명 로그인 (계정·개인정보 없음)
    function isAnonymous() {
      return isAuthenticated() &&
             request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    // 이 기기(익명 uid)가 연결된 학생 문서 ID
    function myStudentId() {
      return get(memberPath()).data.studentId;
    }

    // 학생인지 확인: 익명 로그인 + 수업 코드로 입장해 학생 문서와 연결된 기기
    function isStudent() {
      return isAnonymous() && exists(memberPath());
    }

    // 열려 있고 기간이 남은 수업 코드인지, classId가 맞는지 확인
    function isOpenSession(code, classId) {
      let sessionPath = /databases/$(database)/documents/sessions/$(code);
      let session = get(sessionPath).data;
      return exists(sessionPath) &&
             session.active == true &&
             session.expiresAt > request.time &&
             session.classId == classId;
    }
    
    // 교사 이메일 형식인지 확인 (형식만으로는 권한 없음)
    function hasTeacherEmail() {
      return isAuthenticated() && 
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*@teacher\\.local$');
    }
    
    function teacherPath() {
      return /databases/$(database)/documents/teachers/$(getTeacherIdFromEmail());
    }
    
    // 교사인지 확인: 학교 비밀번호 확인을 통과해 등록된 교사 문서가 있어야 함
    function isTeacher() {
      return hasTeacherEmail() &&
             exists(teacherPath()) &&
             get(teacherPath()).data.get('passwordHash', '') != '';
    }
    
    // 요청한 학교 비밀번호 해시가 schoolSecrets의 해시와 같은지 확인
    function matchesSchoolPassword(data) {
      return exists(/databases/$(database)/documents/schoolSecrets/$(data.schoolCode)) &&
             data.passwordHash == get(/databases/$(database)/documents/schoolSecrets/$(data.schoolCode)).data.passwordHash;
    }
    
    // 이메일에서 교사 ID 추출
    function getTeacherIdFromEmail() {
      return request.auth.token.email.split('@')[0];
    }
    
    // 관리자인지 확인
    // 관리자는 Firebase Console에서 만든 admin@admin.local 계정 하나뿐
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == 'admin@admin.local';
    }
    
    // ========== 컬렉션별 규칙 ==========
    
    // users 컬렉션: 학생 기록 (문서 ID = {classId}-{번호}, 이름·학교명 없음)
    match /users/{studentId} {
      // 학생은 자기 기기와 연결된 문서만 읽기 가능
      allow get: if isAnonymous() && request.auth.uid in resource.data.members;
      
      // 처음 입장: 열린 수업 코드 + 문서 ID가 classId-번호와 일치 + 자기 uid만 등록
      allow create: if isAnonymous() &&
        isOpenSession(request.resource.data.sessionCode, request.resource.data.classId) &&
        studentId == request.resource.data.classId + '-' + string(request.resource.data.number) &&
        request.resource.data.studentId == studentId &&
        request.resource.data.members == [request.auth.uid] &&
        request.resource.data.expiresAt is timestamp &&
        // 개인정보가 들어갈 수 없도록 저장 가능한 필드를 고정
        request.resource.data.keys().hasOnly(['studentId', 'classId', 'schoolCode', 'grade', 'classNum',
          'number', 'sessionCode', 'members', 'lastLogin', 'expiresAt']);
      
      // 다시 입장(다른 기기 포함): 열린 수업 코드로 자기 uid 추가만 가능
      allow update: if isAnonymous() &&
        isOpenSession(request.resource.data.sessionCode, resource.data.classId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'sessionCode', 'lastLogin', 'expiresAt']) &&
        request.resource.data.members.hasAll(resource.data.members) &&
        request.resource.data.members.size() <= resource.data.members.size() + 1 &&
        request.auth.uid in request.resource.data.members;
      
      // 교사는 학생 기록 읽기 가능
      allow get: if isTeacher();
      allow list: if isTeacher();
      
      // 교사는 활동 종료 시 자기 반 학생 기록만 삭제 가능
      allow delete: if isTeacher() && resource.data.classId == getTeacherIdFromEmail();
      
      // activities 서브컬렉션: 문제 답안과 진도
      match /activities/{activityId} {
        allow read, write: if isStudent() && myStudentId() == studentId;
        
        allow get: if isTeacher();
        allow list: if isTeacher();
        
        allow delete: if isTeacher() &&
          get(/databases/$(database)/documents/users/$(studentId)).data.classId == getTeacherIdFromEmail();
      }
    }
    
    // members 컬렉션: 익명 기기 uid → 학생 문서 연결 (본인만)
    match /members/{uid} {
      allow get: if isAnonymous() && request.auth.uid == uid;
      
      // 같은 배치에서 학생 문서의 members에 자기 uid가 들어간 경우에만 생성/갱신
      allow create, update: if isAnonymous() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['studentId', 'classId', 'schoolCode', 'expiresAt']) &&
        request.auth.uid in getAfter(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data.members;
      
      allow delete: if isAnonymous() && request.auth.uid == uid;
      
      // 교사는 활동 종료 시 자기 반 기기 연결만 조회·삭제 가능
      allow list, delete: if isTeacher() && resource.data.classId == getTeacherIdFromEmail();
    }
    
    // sessions 컬렉션: 교사가 만든 수업 코드
    match /sessions/{code} {
      // 코드를 아는 사람만 조회 (목록 조회는 자기 반 교사만)
      allow get: if isAuthenticated();
      allow list: if isTeacher() && resource.data.classId == getTeacherIdFromEmail();
      
      allow create: if isTeacher() &&
        request.resource.data.code == code &&
        request.resource.data.classId == getTeacherIdFromEmail() &&
        request.resource.data.active == true &&
        request.resource.data.expiresAt is timestamp;
      
      // 자기 반 코드 닫기만 가능
      allow update: if isTeacher() &&
        resource.data.classId == getTeacherIdFromEmail() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      
      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.classId == getTeacherIdFromEmail());
    }
    
    // classes 컬렉션: 반별 학생 그룹
    match /classes/{classId} {
      // 교사는 자신의 반 데이터 읽기/쓰기 가능
      allow read, write: if isTeacher() && 
        getTeacherIdFromEmail() == classId;
      
      // 임시: 모든 교사가 모든 반 데이터 읽기 가능 (디버깅용)
      // 주의: 실제 운영 시에는 위의 규칙만 사용하고 이 줄을 제거하세요
      // 서브컬렉션을 list하려면 부모 문서에 대한 get 권한도 필요
      allow get: if isTeacher();
      allow list: if isTeacher();
      
      // students 서브컬렉션
      match /students/{studentId} {
        // 교사는 자신의 반 학생 목록 읽기 가능
        // 서브컬렉션 list는 부모 문서의 get 권한도 필요하므로 위에서 허용됨
        allow get: if isTeacher() && 
          getTeacherIdFromEmail() == classId;
        allow list: if isTeacher() && 
          getTeacherIdFromEmail() == classId;
        
        // 임시: 모든 교사가 모든 반 학생 목록 읽기 가능 (디버깅용)
        allow get: if isTeacher();
        allow list: if isTeacher();
        
        // 학생은 입장할 때 자신을 반 명단에 추가 (같은 배치에서 학생 문서에 자기 uid가 있어야 함)
        allow create, update: if isAnonymous() &&
          studentId == classId + '-' + string(request.resource.data.number) &&
          request.resource.data.keys().hasOnly(['studentId', 'number', 'isActive', 'joinedAt', 'expiresAt']) &&
          request.auth.uid in getAfter(/databases/$(database)/documents/users/$(studentId)).data.members;
        
        // 교사는 자신의 반 학생 추가/업데이트 가능
        allow write: if isTeacher() && 
          getTeacherIdFromEmail() == classId;
        
        // 임시: 모든 교사가 모든 반 학생 추가/업데이트 가능 (디버깅용)
        allow write: if isTeacher();
      }
    }
    
    // teachers 컬렉션: 교사 계정 정보
    match /teachers/{teacherId} {
      // 교사 본인과 관리자만 읽기 가능
      allow get: if hasTeacherEmail() && getTeacherIdFromEmail() == teacherId;
      allow read: if isAdmin();
      
      // 교사 등록/재확인: 학교 비밀번호 해시가 맞아야 하고, 문서 ID와 학교/학년/반이 일치해야 함
      // teacherId는 {schoolCode}-{grade}-{classNum} 형식
      allow create, update: if hasTeacherEmail() &&
        getTeacherIdFromEmail() == teacherId &&
        request.resource.data.teacherId == teacherId &&
        request.resource.data.schoolCode is string &&
        teacherId == request.resource.data.schoolCode + '-' + string(request.resource.data.grade) + '-' + string(request.resource.data.classNum) &&
        !('password' in request.resource.data) &&
        matchesSchoolPassword(request.resource.data);
      
      // 관리자는 정리(평문 비밀번호 제거, 학교 삭제 시 교사 삭제) 가능
      allow update, delete: if isAdmin();
    }
    
    // schoolSecrets 컬렉션: 학교 비밀번호 해시 (공개 읽기 금지)
    match /schoolSecrets/{schoolCode} {
      allow read, write: if isAdmin();
      allow get: if isTeacher() && get(teacherPath()).data.schoolCode == schoolCode;
    }
    
    // classMessages 컬렉션: 반 전체 공지 (교사만 작성, 학생은 읽기만)
    match /classMessages/{classId}/messages/{messageId} {
      // 교사는 자기 반 공지만 작성·조회·삭제
      allow read, delete: if isTeacher() && getTeacherIdFromEmail() == classId;
      allow create: if isTeacher() && getTeacherIdFromEmail() == classId &&
        request.resource.data.classId == classId &&
        request.resource.data.readBy == {} &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.keys().hasOnly(['classId', 'senderName', 'title', 'content', 'readBy', 'createdAt', 'expiresAt']);
      
      // 학생은 자기 반 공지만 읽기
      allow read: if isStudent() &&
        get(/databases/$(database)/documents/users/$(myStudentId())).data.classId == classId;
      
      // 학생은 readBy에 자기 표시만 추가 가능
      allow update: if isStudent() &&
        get(/databases/$(database)/documents/users/$(myStudentId())).data.classId == classId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
        request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([myStudentId()]) &&
        request.resource.data.readBy[myStudentId()] == true;
    }
    
    // schools 컬렉션: 학교 정보 (선택사항)
    // 학교 목록은 로그인 전에도 조회 가능해야 하므로 공개 읽기 허용
    match /schools/{schoolCode} {
      // 누구나 읽기 가능 (로그인 전 학생도 학교 목록을 볼 수 있어야 함)
      // 비밀번호는 여기 두지 않고 schoolSecrets에 해시로 저장
      allow read: if true;
      
      // 쓰기는 관리자만 가능
      // 주의: 관리자는 admin@admin.local 형식의 Firebase Authentication 계정으로 로그인해야 함
      allow write: if isAdmin();
    }
  }
}

